# ── Supabase ───────────────────────────────────────────────────────
# Painel do projeto Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — só usada no servidor (nunca expor no client). Necessária pro worker de disparo.
SUPABASE_SERVICE_ROLE_KEY=

# ── E-mail (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Claude (Anthropic) — agentes de IA (provider padrão) ───────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Gemini (Google) — provider alternativo, só pra agente com llm_provider='gemini' ─
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# ── OpenAI — só usado pra transcrição de áudio (Whisper), não como provider de resposta ─
OPENAI_API_KEY=

# ── Evolution API (WhatsApp — canal não oficial/Baileys) ───────────
EVOLUTION_URL=
EVOLUTION_APIKEY=
# URL pública deste app (Vercel) + ?secret=<mesmo valor de WHATSAPP_WEBHOOK_SECRET abaixo>
EVOLUTION_WEBHOOK_URL=
# Segredo compartilhado que valida quem chama /api/webhook/whatsapp e /api/webhook/dialog360 — gere com:
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WHATSAPP_WEBHOOK_SECRET=

# ── Meta Cloud API direto (Tech Provider — Embedded Signup) ────────
# App ID/Config ID não são segredo (vão pro navegador de propósito, usados no SDK do FB.login) —
# painel do App da Meta em developers.facebook.com
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
# Esse sim é segredo — nunca com prefixo NEXT_PUBLIC_
META_APP_SECRET=
# Token de System User da conta de negócios da AutomaX (Tech Provider) — não é por cliente
META_SYSTEM_USER_TOKEN=

# ── Cron (dispatch-campaigns, followups) ────────────────────────────
# Autentica quem chama /api/cron/* (cron externo/VPS, ou Vercel Cron nativo) — gere igual ao secret acima
CRON_SECRET=

# ── Descadastro de e-mail (link no rodapé da campanha) ──────────────
# Assina o token do link de unsubscribe — sem isso, o link fica sempre inválido (fail-closed, ver
# src/lib/unsubscribe.ts) em vez de quebrar de forma insegura
UNSUBSCRIBE_SECRET=
